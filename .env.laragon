# Configuracion para companeros usando LARAGON en Windows
# Copia o renombra este archivo como .env
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=minimarket_mass
DB_USER=root
DB_PASSWORD=

# Cabecera del ticket y facturacion electronica (ver .env.example y docs/facturacion_electronica.md)
EMPRESA_RAZON_SOCIAL=
EMPRESA_RUC=
EMPRESA_NOMBRE_COMERCIAL=TIENDA MASS
EMPRESA_DIRECCION_FISCAL=
TICKET_ANCHO_MM=80
FACTURACION_PROVEEDOR=ninguno
NUBEFACT_URL=
NUBEFACT_TOKEN=
