# Copia este archivo como .env y cambia las claves. El .env NO se sube a GitHub.
# Lo leen docker-compose.yml (para crear la base) y la aplicacion PHP (para conectarse).
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=minimarket_mass
DB_USER=mass_app
DB_PASSWORD=cambia_esta_clave
DB_ROOT_PASSWORD=cambia_esta_clave_root

# PCs del equipo: "web" levanta tambien la pagina y la API en Docker (http://localhost:8000).
# En un servidor de produccion dejarlo vacio (COMPOSE_PROFILES=): ahi atiende nginx o Apache.
COMPOSE_PROFILES=web
WEB_PORT=8000
