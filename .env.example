# Copia este archivo como .env y cambia las claves. El .env NO se sube a GitHub.
# Lo leen docker-compose.yml (para crear la base) y la aplicacion PHP (para conectarse).
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=minimarket_mass
DB_USER=mass_app
DB_PASSWORD=cambia_esta_clave
DB_ROOT_PASSWORD=cambia_esta_clave_root

# PCs del equipo: "web" levanta tambien la pagina y la API en Docker (http://localhost:8000).
# En un servidor de produccion dejarlo vacio (COMPOSE_PROFILES=): ahi atiende nginx o Apache.
COMPOSE_PROFILES=web
WEB_PORT=8000

# Respaldos (docs/despliegue.md, seccion 10). Vacios = el respaldo queda solo en este disco y sin cifrar.
# RESPALDO_CLAVE cifra cada respaldo con gpg: anotala tambien FUERA del servidor, sin ella no se puede restaurar.
# RESPALDO_REMOTO es un remoto de rclone (rclone config), por ejemplo drive:minimarket_mass, o una carpeta de un USB.
RESPALDO_CLAVE=
RESPALDO_REMOTO=
RESPALDO_DIAS_REMOTO=90
# Cuantos respaldos se guardan en este disco (30 = un mes si es diario)
RESPALDO_GUARDAR=30
# Donde esta MySQL: vacio = Docker si existe el contenedor; "local" = MySQL de la PC o Laragon (seccion 10.3).
# En modo local, usuario con permiso para toda la base (si no se pone, DB_USER y DB_PASSWORD). Ej.: root por el socket.
RESPALDO_MODO=
RESPALDO_DB_USER=
RESPALDO_DB_PASSWORD=
RESPALDO_DB_HOST=
RESPALDO_DB_PORT=

# Cabecera del ticket (docs/facturacion_electronica.md). Una sola empresa para las 3 tiendas.
# Vacios = el ticket no muestra RUC ni razon social y la pagina del ticket avisa que faltan.
EMPRESA_RAZON_SOCIAL=
EMPRESA_RUC=
EMPRESA_NOMBRE_COMERCIAL=TIENDA MASS
EMPRESA_DIRECCION_FISCAL=

# Ancho del papel de la ticketera termica: 80 o 58 (mm). Cada caja puede cambiarlo en la pagina del ticket.
TICKET_ANCHO_MM=80

# Facturacion electronica (boleta y factura ante SUNAT). ninguno = el ticket sale como TICKET INTERNO,
# no valido como comprobante de pago. nubefact = proveedor OSE/PSE (preparado, aun no conectado a la venta).
# La ruta y el token los da el proveedor al dueño: solo aqui, nunca en GitHub. Confirmar con un contador.
FACTURACION_PROVEEDOR=ninguno
NUBEFACT_URL=
NUBEFACT_TOKEN=

# Soporte: a quien llamar si algo falla. Sale en el pie de cada pagina y en Ayuda (backend/config/Aplicacion.php).
# El telefono solo con digitos y espacios (y + al inicio); vacios = solo se muestra el nombre.
SOPORTE_NOMBRE=Administrador del sistema
SOPORTE_TELEFONO=
SOPORTE_CORREO=
SOPORTE_HORARIO=Lunes a sábado, 7:00 a 22:00

# Asistente inteligente (menú Asistente): responde preguntas en español con los datos del sistema usando Claude.
# La clave se crea en https://platform.claude.com (API keys). Vacía = solo preguntas rápidas y palabras clave (sin IA).
# Solo aquí, nunca en GitHub. ANTHROPIC_MODEL es opcional (por defecto claude-opus-5-5).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Enviar el comprobante por correo al cliente (botón "Enviar correo" del comprobante, con el PDF adjunto).
# Vacíos = el botón dice "Abrir en Gmail" y abre Gmail en el navegador con el comprobante ya escrito.
# Con Gmail: CORREO_SMTP_HOST=smtp.gmail.com, CORREO_SMTP_PUERTO=587, CORREO_USUARIO=tucuenta@gmail.com y
# CORREO_CLAVE = la "contraseña de aplicación" de 16 letras (myaccount.google.com/apppasswords), no la clave normal.
# Solo aquí, nunca en GitHub. WhatsApp no necesita nada: abre wa.me con el comprobante escrito.
CORREO_SMTP_HOST=
CORREO_SMTP_PUERTO=587
CORREO_USUARIO=
CORREO_CLAVE=
CORREO_REMITENTE=TIENDA MASS
# tls (587), ssl (465) o ninguno (solo para un buzón de prueba local como Mailpit). Vacío = según el puerto.
CORREO_SMTP_CIFRADO=
