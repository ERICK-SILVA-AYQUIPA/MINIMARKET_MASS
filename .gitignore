# OS files
.DS_Store
Thumbs.db

# Editor and IDE directories
.vscode/
.idea/
*.swp
*.swo

# Temporary and local log files
*.log
scratch/

# Configuracion local con claves (usar .env.example como plantilla)
.env
respaldos/
# PHPStan se baja como .phar (README, Pruebas y revision automatica)
phpstan.phar

# Fotos de productos que sube el administrador (backend/scripts/respaldo las incluye en cada respaldo)
frontend/public/img/productos/*
!frontend/public/img/productos/.gitkeep

# APK y paquetes de Android generados (se descargan desde la CI o Releases, no se suben)
*.apk
*.aab

# Pruebas E2E (Playwright): dependencias e informes; las capturas base (tests/e2e/*-snapshots/) SI se suben
node_modules/
test-results/
playwright-report/
